# Copy this file to .env and update your MySQL settings.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=online_banking
DB_SSL_CA=

# Replace with a long random value before using beyond a local demo.
SECRET_KEY=replace-this-with-a-long-random-secret-key
PORT=5000
FLASK_DEBUG=1
COOKIE_SECURE=0

